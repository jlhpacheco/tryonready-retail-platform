# Copy to a local .env file and provide development-only values.
# Never commit real credentials.

NODE_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

DATABASE_URL=Host=localhost;Port=5432;Database=tryonready;Username=tryonready;Password=replace-locally

YOUCAM_API_BASE_URL=https://replace-with-official-endpoint
YOUCAM_API_KEY=replace-locally
YOUCAM_API_SECRET=replace-locally

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=tryonready-demo
OBJECT_STORAGE_ACCESS_KEY=replace-locally
OBJECT_STORAGE_SECRET_KEY=replace-locally

DEMO_MODE=true
ENABLE_SYNTHETIC_METRICS=true
UPLOAD_RETENTION_HOURS=24
RESULT_RETENTION_HOURS=24
