<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ClientAppRoot>$(MSBuildProjectDirectory)\..\..\apps\web</ClientAppRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TryOnReady.Application\TryOnReady.Application.csproj" />
    <ProjectReference Include="..\TryOnReady.Infrastructure\TryOnReady.Infrastructure.csproj" />
    <ProjectReference Include="..\TryOnReady.YouCam\TryOnReady.YouCam.csproj" />
  </ItemGroup>

  <Target Name="BuildClientApp" BeforeTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec
      WorkingDirectory="$(ClientAppRoot)"
      Command="npm install --no-audit --no-fund"
      Condition="!Exists('$(ClientAppRoot)\node_modules')" />
    <Exec WorkingDirectory="$(ClientAppRoot)" Command="npm run build" />
    <ItemGroup>
      <ClientAppFiles Include="$(ClientAppRoot)\out\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)\wwwroot" />
    <Copy
      SourceFiles="@(ClientAppFiles)"
      DestinationFiles="@(ClientAppFiles->'$(MSBuildProjectDirectory)\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
